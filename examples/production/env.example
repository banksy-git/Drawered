# Copy to .env and fill in. See SPEC.md section 11 for all settings.

# Public host name; DNS must point at this server for the certificate.
DRAWERED_HOST=drawered.example.com

# Register Drawered with your IdP using the redirect URI
# https://<DRAWERED_HOST>/auth/callback
DRAWERED_OIDC_ISSUER=https://idp.example.com/application/o/drawered/
DRAWERED_OIDC_CLIENT_ID=drawered
DRAWERED_OIDC_CLIENT_SECRET=

# Set to "groups" if your IdP only sends groups when asked.
DRAWERED_OIDC_SCOPES=

# Email or subject of users given the Admin role on first login.
DRAWERED_BOOTSTRAP_ADMINS=you@example.com

# Image tag, e.g. v0.1 to pin a release.
DRAWERED_VERSION=latest
